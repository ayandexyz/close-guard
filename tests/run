#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"

lua_bin="$(command -v lua || command -v lua5.4 || true)"
if [ -n "$lua_bin" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/home/.config/omarchy" "$tmp/state/close-guard"
  printf '{"plugins":[{"id":"io.github.ayandexyz.close-guard"}]}\n' > "$tmp/home/.config/omarchy/shell.json"
  HOME="$tmp/home" XDG_STATE_HOME="$tmp/state" "$lua_bin" "$root/tests/binding_test.lua" "$root/hypr/close-guard.lua"
fi

if command -v qmllint >/dev/null 2>&1 && [ -d "${OMARCHY_PATH:-/usr/share/omarchy}/shell" ]; then
  qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" "$root"/*.qml
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

printf 'All portable plugin checks passed.\n'
